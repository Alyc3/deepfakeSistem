---
import type { IdentityUser } from "@domain/identity";
import AnalisisView from "@ui/components/AnalisisView.astro";
interface Props { user: IdentityUser }
const { user } = Astro.props;
---
<section id="cases-page" data-user={JSON.stringify(user)}>
  <div id="cases-browser">
  <div class="page-heading"><div><p class="eyebrow">Archivo pericial</p><h1>Casos y evidencias</h1><p class="page-description">Cada expediente organiza su evidencia original, copia de trabajo y reportes.</p></div></div>
  <div class="cases-layout">
    <section class="surface cases-create"><div class="surface-heading"><h2>Nuevo expediente</h2></div><form id="case-create-form" class="sheet-form">
      <label class="field"><span>Número de caso</span><input class="text-input" name="case_number" maxlength="100" required /></label>
      <label class="field"><span>Nombre del caso</span><input class="text-input" name="title" maxlength="255" required /></label>
      <label class="field"><span>Descripción</span><textarea class="text-input" name="description" rows="3"></textarea></label>
      <button class="primary-button" type="submit">Crear caso</button><p id="case-message" class="form-error" role="status"></p>
    </form></section>
    <section class="surface cases-list"><div class="surface-heading"><h2>Expedientes</h2><button id="cases-refresh" class="ghost-button" type="button">Actualizar</button></div><div id="cases-list" class="case-cards" aria-live="polite"><p class="inline-message">Cargando expedientes…</p></div></section>
  </div>
  </div>
  <AnalisisView />
</section>
