---
import type { IdentityUser } from "@domain/identity";
import Icon from "./Icon.astro";
interface Props { user: IdentityUser; section: string; }
const { user, section } = Astro.props;
const name = [user.first_name, user.last_name].filter(Boolean).join(" ") || user.email;
const initials = name.split(/\s+/).slice(0, 2).map((value) => value[0]).join("").toUpperCase();
---
<div class="page-heading"><div><p class="eyebrow">Mi cuenta</p><h1>{section === "perfil" ? "Mi perfil" : "Seguridad"}</h1><p class="page-description">{section === "perfil" ? "Tu identidad dentro del equipo." : "Mantén el control de tu acceso."}</p></div></div>
{section === "perfil" ? <div class="account-grid"><section class="surface profile-summary"><div class="profile-avatar">{initials}</div><h2>{name}</h2><p>{user.email}</p><span class="badge badge-moss">{user.role.name}</span><div class="profile-status"><span class="status-pip"></span>Cuenta activa</div></section><section class="surface"><div class="surface-heading"><h2>Información personal</h2></div><dl class="profile-details">{[["Nombre", user.first_name], ["Apellido", user.last_name], ["Correo electrónico", user.email], ["Identificación", user.identifier], ["Teléfono", user.phone_number], ["Rol", user.role.name]].map(([label, value]) => <div><dt>{label}</dt><dd>{value || "Sin registrar"}</dd></div>)}</dl><p class="surface-note">Para actualizar tus datos, contacta al administrador.</p></section></div> : <div class="security-grid"><section class="surface security-card"><span class="card-icon"><Icon name="lock" size={24} /></span><h2>Contraseña</h2><p>Recibe un enlace para actualizar tu contraseña.</p><form id="account-recovery-form"><input name="email" type="hidden" value={user.email} /><button class="ghost-button" type="submit">Enviar enlace de recuperación</button><p id="account-recovery-message" class="inline-message" role="status"></p></form></section><section class="surface security-card"><span class="card-icon"><Icon name="shield" size={24} /></span><h2>Sesión actual</h2><p>Has iniciado sesión como <strong>{user.email}</strong>.</p><span class="badge badge-moss">Activa</span><div class="security-actions"><button id="security-logout" class="ghost-button" type="button">Cerrar esta sesión</button></div></section></div>}
