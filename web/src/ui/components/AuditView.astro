---
import Icon from "./Icon.astro";
---
<section aria-label="Auditoría de seguridad">
  <div class="page-heading"><div><p class="eyebrow">Administración</p><h1>Auditoría</h1><p class="page-description">Inicios de sesión, cambios de cuentas y eventos de seguridad del servicio de usuarios.</p></div></div>
  <div class="surface">
    <form id="audit-filter" class="table-toolbar audit-toolbar">
      <label class="search-field"><Icon name="search" size={18} /><input name="action" type="search" placeholder="Acción, p. ej. login_failed" aria-label="Filtrar por acción" maxlength="100" list="audit-actions" /></label>
      <datalist id="audit-actions">
        {["login_success", "login_failed", "account_locked", "logout", "logout_all", "session_revoked", "refresh_token_reuse_detected", "password_changed", "password_change_failed", "password_reset", "password_reset_requested", "profile_updated", "user_created", "user_updated", "user_deleted", "user_suspended", "user_unsuspended", "user_unlocked", "user_sessions_revoked", "user_mfa_reset", "mfa_enabled", "mfa_disabled", "role_created", "role_updated", "role_deleted"].map((action) => <option value={action} />)}
      </datalist>
      <label class="field audit-date"><span class="visually-hidden">Desde</span><input class="text-input" name="date_from" type="date" aria-label="Desde" /></label>
      <label class="field audit-date"><span class="visually-hidden">Hasta</span><input class="text-input" name="date_to" type="date" aria-label="Hasta" /></label>
    </form>
    <p id="audit-message" class="inline-message" role="status" aria-live="polite"></p>
    <div class="table-scroll"><table class="data-table audit-table"><thead><tr><th>Fecha</th><th>Acción</th><th>Usuario</th><th>Origen</th><th>Detalles</th></tr></thead><tbody id="audit-rows"></tbody></table></div>
    <div id="audit-empty" class="empty-state" hidden><Icon name="list" size={32} /><h3>Sin eventos</h3><p>No hay registros con esos filtros.</p></div>
    <div class="table-footer"><span id="audit-count"></span><span class="audit-pager"><button id="audit-prev" class="text-action" type="button" disabled>← Anteriores</button><button id="audit-next" class="text-action" type="button" disabled>Siguientes →</button></span></div>
  </div>
</section>
