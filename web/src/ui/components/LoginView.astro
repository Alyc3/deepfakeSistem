---
/** Vista 2 — Acceso: identificación del perito antes de abrir el laboratorio. */
---

<section id="view-login" class="view view-login">
  <div class="login-card">
    <img src="/assets/art/reticle.svg" alt="" class="login-reticle" aria-hidden="true" />
    <p class="eyebrow">Tu espacio de trabajo</p>
    <h1 id="login-title" class="login-title">Hola de nuevo</h1>
    <p id="login-hint" class="login-hint">
      Accede con tu cuenta institucional.
    </p>

    <form id="login-form" class="login-form">

      <label class="field">
        <span class="mono-label">Correo electrónico</span>
        <input
          id="login-user"
          class="text-input"
          type="email"
          autocomplete="username"
          spellcheck="false"
          required
        />
      </label>
      <label class="field">
        <span class="mono-label">Clave</span>
        <input
          id="login-pass"
          class="text-input"
          type="password"
          autocomplete="current-password"
          required
        />
      </label>
      <p id="login-error" class="login-error" role="alert" hidden></p>
      <button id="login-submit" class="primary-button" type="submit">
        Iniciar sesión
      </button>
    </form>

    <!-- Segundo paso: solo aparece si la cuenta tiene verificación en dos pasos. -->
    <form id="mfa-form" class="login-form" hidden>
      <label class="field">
        <span class="mono-label">Código de verificación</span>
        <input
          id="mfa-code"
          class="text-input"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9 ]{6,8}"
          maxlength="8"
          required
        />
      </label>
      <p id="mfa-error" class="login-error" role="alert" hidden></p>
      <button id="mfa-submit" class="primary-button" type="submit">Verificar código</button>
      <button id="mfa-cancel" class="link-button" type="button">← Usar otra cuenta</button>
    </form>

    <div id="login-links" class="login-links"><a class="link-button" href="/">← Volver</a><a class="link-button" href="/recuperar">Olvidé mi contraseña</a></div>
  </div>
</section>
