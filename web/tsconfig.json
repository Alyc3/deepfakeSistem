{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    // Los alias hacen visibles las fronteras de la arquitectura hexagonal: si
    // un import cruza una capa que no le corresponde, se ve a simple vista.
    "paths": {
      "@domain/*": ["src/domain/*"],
      "@application/*": ["src/application/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@ui/*": ["src/ui/*"]
    }
  }
}
