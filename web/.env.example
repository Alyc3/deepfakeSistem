# CertiFace web — variables de entorno.
# Plantilla: copia a .env (desarrollo) o usa .env.production (Render). Nunca subas valores reales.

# --- Servicio de usuarios (auth-service) ---
AUTH_SERVICE_URL=https://authentication-service.fastapicloud.dev
# La misma INTERNAL_API_KEY del auth-service: reenvía la IP y el navegador reales de cada usuario.
AUTH_INTERNAL_API_KEY=

# --- Motor forense (backend) ---
# Motor por defecto. Vacío mientras el backend no esté desplegado: se conecta desde el panel oculto.
CERTIFACE_API_URL=http://127.0.0.1:8000
# Panel oculto Ctrl+Alt+Shift+M para que cada sesión use otro motor (p. ej. el de tu equipo con un túnel).
# Ponlo en false cuando el backend esté desplegado y CERTIFACE_API_URL definida.
FORENSICS_API_OVERRIDE=true
# En producción el panel solo acepta estos dominios HTTPS (los de cloudflared y ngrok).
FORENSICS_API_OVERRIDE_HOSTS=*.trycloudflare.com,*.ngrok-free.app,*.ngrok.app

# --- Sitio y sesión ---
# URL pública exacta de la web.
APP_ORIGIN=http://localhost:4321
# Duración máxima de la sesión desde el login (segundos); los tokens se renuevan solos.
SESSION_TTL_SECONDS=14400
# true con HTTPS. Las compilaciones de producción siempre usan cookie Secure.
SESSION_COOKIE_SECURE=false
# Proxies delante del servidor (Render: 1). 0 usa la IP de la conexión.
TRUSTED_PROXY_COUNT=0

# --- Permisos por rol: laboratory, users, roles, audit, profile, security ---
ROLE_PERMISSIONS='{"ADMINISTRADOR":["laboratory","users","roles","audit","profile","security"],"PERITO":["laboratory","profile","security"],"ABOGADO":["profile","security"]}'
DEFAULT_PERMISSIONS='["profile","security"]'
