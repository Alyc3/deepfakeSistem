{
  "name": "certiface-web",
  "productName": "CertiFace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio pericial de medios digitales en la web: detección de face swap y deepfake para casos de suplantación de identidad",
  "author": "Alyce Maldonado",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "check": "astro check",
    "test:identity": "node --test tests/identity.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node --env-file=.env dist/server/entry.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^26.6.5",
    "astro": "^7.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9"
  }
}
