## 4. Persistencia en Base de Datos (Neon PostgreSQL 16)

La conexión a la base de datos se realiza sobre Neon DB (AWS `sa-east-1`) con el pooler habilitado y forzado de SSL (`sslmode=require&channel_binding=require`).

### Esquema DDL Forense Completo

```sql
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. Peritos y Usuarios (Sincronizado con el Microservicio de Auth)
CREATE TABLE peritos (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    external_auth_id VARCHAR(255) UNIQUE NOT NULL, -- ID del auth-service
    email VARCHAR(255) NOT NULL,
    first_name VARCHAR(150) NOT NULL,
    last_name VARCHAR(150) NOT NULL,
    identifier VARCHAR(100) NOT NULL,              -- Cédula / Matrícula pericial
    role_name VARCHAR(50) NOT NULL,
    phone_number VARCHAR(50),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    last_synced_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 2. Expedientes Forenses
CREATE TABLE forensic_cases (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    case_number VARCHAR(100) UNIQUE NOT NULL,       -- Identificador judicial (ej: EXP-2026-DF-001)
    title VARCHAR(255) NOT NULL,
    description TEXT,
    perito_id UUID NOT NULL REFERENCES peritos(id),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 3. Evidencias Digitales (Preservación estricta ISO/IEC 27037)
CREATE TABLE evidences (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    case_id UUID NOT NULL REFERENCES forensic_cases(id) ON DELETE CASCADE,
    file_name VARCHAR(255) NOT NULL,
    file_size_bytes BIGINT NOT NULL,
    mime_type VARCHAR(100) NOT NULL,
    sha256_original CHAR(64) NOT NULL,              -- Huella digital inmutable de la evidencia original
    sha256_working_copy CHAR(64) NOT NULL,         -- Huella digital verificada de la copia de trabajo
    original_storage_uri TEXT NOT NULL,            -- Ubicación protegida contra escritura
    working_storage_uri TEXT NOT NULL,             -- Ubicación de la copia evaluada por el pipeline
    duration_seconds NUMERIC(8, 3),
    fps NUMERIC(6, 2),
    total_frames INT,
    width INT,
    height INT,
    uploaded_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 4. Registro Integral de Auditoría y Cadena de Custodia
CREATE TABLE custody_audit_log (
    id BIGSERIAL PRIMARY KEY,
    evidence_id UUID REFERENCES evidences(id) ON DELETE CASCADE,
    perito_id UUID REFERENCES peritos(id),
    action VARCHAR(100) NOT NULL,                   -- INGESTION, WORKING_COPY_VERIFIED, ACCESSED, ANALYZED, REPORT_GENERATED, DOWNLOADED
    ip_address VARCHAR(45) NOT NULL,
    user_agent TEXT,
    hash_verified BOOLEAN NOT NULL DEFAULT TRUE,
    synced_to_central_audit BOOLEAN DEFAULT FALSE,  -- Estado de replicación hacia POST /api/internal/audit
    details JSONB DEFAULT '{}'::jsonb,              -- Metadatos adicionales de la acción
    timestamp TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 5. Dictámenes Periciales y Resultados de Inferencia
CREATE TABLE analysis_reports (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    evidence_id UUID NOT NULL REFERENCES evidences(id) ON DELETE CASCADE,
    perito_id UUID NOT NULL REFERENCES peritos(id),
    status VARCHAR(30) NOT NULL DEFAULT 'QUEUED',   -- QUEUED, PROCESSING, COMPLETED, FAILED
    
    -- Clasificación Tripartita Estricta
    verdict VARCHAR(30) CHECK (verdict IN ('MANIPULADO', 'SIN_MANIPULACION', 'ANTECEDENTES', NULL)),
    confidence_score NUMERIC(5, 2),                 -- 0.00 a 100.00
    caveat_notes TEXT,                              -- Observaciones o reservas técnicas
    
    -- Métricas de Ejecución
    processing_time_seconds NUMERIC(8, 2),
    hardware_info VARCHAR(255),
    frames_analyzed INT,
    faces_detected INT,
    
    -- Scores Estructurados por Modelo
    models_metadata JSONB NOT NULL DEFAULT '{}'::jsonb,
    
    expert_conclusions TEXT,                        -- Conclusiones obligatorias redactadas por el perito
    pdf_report_uri TEXT,                            -- Ruta de almacenamiento del PDF final
    pdf_sha256 CHAR(64),                            -- Hash de integridad del dictamen emitido
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    completed_at TIMESTAMP WITH TIME ZONE
);

-- 6. Detección Temporal de Inconsistencias (Marcas de Tiempo Exactas)
CREATE TABLE timecode_inconsistencies (
    id BIGSERIAL PRIMARY KEY,
    report_id UUID NOT NULL REFERENCES analysis_reports(id) ON DELETE CASCADE,
    timecode_start VARCHAR(12) NOT NULL,            -- Formato exacto: "00:01:23.450"
    timecode_end VARCHAR(12) NOT NULL,              -- Formato exacto: "00:01:25.100"
    duration_seconds NUMERIC(6, 3) NOT NULL,
    frame_start INT NOT NULL,
    frame_end INT NOT NULL,
    peak_timecode VARCHAR(12) NOT NULL,
    peak_frame INT NOT NULL,
    peak_anomaly_score NUMERIC(5, 4) NOT NULL,
    anomaly_family VARCHAR(50) NOT NULL,            -- "FACE_SWAP", "DIFFUSION", "GAN"
    demonstrative_plate_uri TEXT                    -- Imagen de la lámina demostrativa para el dictamen
);

CREATE INDEX idx_evidences_sha256 ON evidences(sha256_original);
CREATE INDEX idx_custody_evidence ON custody_audit_log(evidence_id);
CREATE INDEX idx_custody_perito ON custody_audit_log(perito_id);
CREATE INDEX idx_reports_verdict ON analysis_reports(verdict);
CREATE INDEX idx_inconsistencies_report ON timecode_inconsistencies(report_id);
```

