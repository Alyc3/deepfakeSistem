# Configuración de CertiFace Backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/certiface?sslmode=require
AUTH_SERVICE_URL=https://auth-service-w3lo.onrender.com
INTERNAL_API_KEY=
STORAGE_DIR=storage_evidence

ROLE_PERMISSIONS='{"ADMINISTRADOR":["laboratory","users","roles","profile","security"],"ADMIN":["laboratory","users","roles","profile","security"],"GERENTE_GENERAL":["laboratory","users","roles","profile","security"],"PERITO":["laboratory","profile","security"],"INVITADO":["profile","security"]}'
DEFAULT_PERMISSIONS='["profile","security"]'

# Almacén forense privado compatible con S3 (Cloudflare R2)
USE_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./uploads
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
FORENSIC_STORAGE_PREFIX=certiface/v1
FORENSIC_REQUIRE_RETENTION=true
FORENSIC_MAX_UPLOAD_BYTES=10485760
FORENSIC_TEMP_PATH=./.runtime-tmp
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Generar una sola vez: python -m scripts.setup_forensic_keys
FORENSIC_SIGNING_KEY_PATH=./.secrets/manifest-signing.pem
FORENSIC_PUBLIC_KEYS_PATH=./keys
FORENSIC_ENCRYPTION_KEYS=
FORENSIC_ACTIVE_ENCRYPTION_KEY_ID=
FORENSIC_SIGNING_KEY_PASSWORD=

# Inferencia asíncrona (Celery + Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_RESULT_EXPIRES=86400
